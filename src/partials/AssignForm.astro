---
export interface Props {
  project?: string | null // optional heading context, sent as a note
}

const { project } = Astro.props as Props
---

<div class="assign">
  <form class="assign-form flex gap-2" data-project={project ?? ''}>
    <input
      type="text"
      name="title"
      required
      maxlength="200"
      autocomplete="off"
      placeholder="Assign me a task…"
      class="min-w-0 flex-1 rounded border border-bd bg-bg2 px-3 py-1.5 text-sm text-fg1 placeholder:text-fg2 focus:border-p1 focus:outline-none"
    />
    <button
      type="submit"
      class="shrink-0 rounded border border-bd bg-bg3 px-3 py-1.5 text-sm text-fg1 hover:text-p1"
    >
      Add
    </button>
  </form>
  <p class="assign-status mt-1 h-4 text-xs text-fg2" aria-live="polite"></p>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('.assign-form').forEach((form) => {
    const status = form.parentElement?.querySelector('.assign-status')
    const input = form.querySelector<HTMLInputElement>('input[name="title"]')
    const button = form.querySelector<HTMLButtonElement>('button')

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const title = input?.value.trim()
      if (!title || !input || !button) return

      button.disabled = true
      if (status) status.textContent = 'Adding…'
      try {
        const res = await fetch('/api/work/assign', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, project: form.dataset.project || null }),
        })
        if (!res.ok) throw new Error(String(res.status))
        input.value = ''
        if (status)
          status.textContent = 'Added ✓ — appears in Things within a couple minutes.'
      } catch {
        if (status) status.textContent = 'Something went wrong — please try again.'
      } finally {
        button.disabled = false
      }
    })
  })
</script>
