---
export interface Props {
  project?: string | null // optional heading context passed to the mailto
}

const { project } = Astro.props as Props
const href = project
  ? `/api/work/assign?project=${encodeURIComponent(project)}`
  : '/api/work/assign'
---

<a
  href={href}
  rel="nofollow"
  class="inline-flex shrink-0 items-center gap-1.5 rounded border border-bd bg-bg3 px-3 py-1.5 text-sm text-fg1 hover:text-p1"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="h-4 w-4"
    aria-hidden="true"
  >
    <rect x="2" y="4" width="20" height="16" rx="2" />
    <path d="m22 7-10 5L2 7" />
  </svg>
  Assign me a task
</a>
