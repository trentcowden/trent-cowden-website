---
import type { WorkGroup, WorkTask } from '@/utils/work'

export interface Props {
  group: WorkGroup
  headingHref?: string // if set, the heading title links here
}

const { group, headingHref } = Astro.props as Props

function marker(status: WorkTask['status']): string {
  if (status === 'completed') return '✓'
  if (status === 'canceled') return '✕'
  return '○'
}

// e.g. "2026-05-26 11:57:09" -> "May 26, 2026"
function fmtDate(value: string | null): string | null {
  if (!value) return null
  const d = new Date(value.replace(' ', 'T'))
  if (Number.isNaN(d.getTime())) return null
  return d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })
}

const title = group.title ?? 'No project'

function tagMinutes(tag: string): number {
  const m = tag
    .trim()
    .toLowerCase()
    .match(
      /^(\d+(?:\.\d+)?)\s*(w|wk|wks|week|weeks|h|hr|hrs|hour|hours|m|min|mins|minute|minutes)$/
    )
  if (!m || !m[1] || !m[2]) return 0
  const value = parseFloat(m[1])
  const unit = m[2]
  if (unit.startsWith('w')) return value * 40 * 60
  if (unit.startsWith('h')) return value * 60
  return value
}

const taskMinutes = (t: WorkTask): number =>
  (t.tags || []).reduce((sum, tag) => sum + tagMinutes(tag), 0)

// 90 -> "1h 30m", 240 -> "4h", 30 -> "30m", 0 -> "0h"
function fmtDuration(mins: number): string {
  const h = Math.floor(mins / 60)
  const m = Math.round(mins % 60)
  return [h && `${h}h`, m && `${m}m`].filter(Boolean).join(' ') || '0h'
}

const openMin = group.tasks
  .filter((t) => t.status === 'incomplete')
  .reduce((sum, t) => sum + taskMinutes(t), 0)
const totalMin = group.tasks.reduce((sum, t) => sum + taskMinutes(t), 0)

// Collapse to a single value when nothing's been done yet.
const estimate =
  totalMin === 0
    ? null
    : openMin === totalMin
    ? fmtDuration(totalMin)
    : `${fmtDuration(openMin)} left · ${fmtDuration(totalMin)} total`
---

<section class='mb-10'>
  <div
    class='mb-4 flex items-baseline justify-between gap-3 border-b border-bd pb-2'
  >
    <h2 class='text-xl font-semibold text-fg1'>
      {headingHref ? (
        <a href={headingHref} class="hover:text-p1">
          {title}
        </a>
      ) : (
        title
      )}
    </h2>
    {estimate && (
      <span class="flex shrink-0 items-center gap-1 text-sm text-fg2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-3.5 w-3.5"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7v5l3 2" />
        </svg>
        {estimate}
      </span>
    )}
  </div>

  <ul class='space-y-3'>
    {group.tasks.map((task) => {
      const done = task.status !== 'incomplete'
      // Backlog = the "Someday" bucket with no scheduled date. A Someday task
      // that DOES have a start_date is actually an Upcoming (future-scheduled)
      // task, not backlog. Muted, but not struck through like done ones.
      const backlog = !done && task.start === 'Someday' && !task.startDate
      const deadline = fmtDate(task.deadline)
      return (
        <li class="flex gap-3">
          <span
            class:list={[
              'select-none pt-0.5 text-sm',
              done || backlog ? 'text-fg2' : 'text-p1',
            ]}
          >
            {marker(task.status)}
          </span>
          <div class="min-w-0">
            <p
              class:list={[
                'leading-snug',
                done && 'text-fg2 line-through',
                backlog && 'text-fg2',
                !done && !backlog && 'text-fg1',
              ]}
            >
              {task.title || '(untitled)'}
              {backlog && (
                <span class="ml-2 whitespace-nowrap rounded bg-bg3 px-1.5 py-0.5 text-xs uppercase tracking-wide text-fg2">
                  backlog
                </span>
              )}
              {deadline && (
                <span class="ml-2 whitespace-nowrap rounded bg-bg3 px-1.5 py-0.5 text-xs text-fg2">
                  due {deadline}
                </span>
              )}
              {(task.tags || []).map((tag) => (
                <span class="ml-2 whitespace-nowrap rounded bg-bg3 px-1.5 py-0.5 text-xs text-fg2">
                  #{tag}
                </span>
              ))}
            </p>
          </div>
        </li>
      )
    })}
  </ul>
</section>
