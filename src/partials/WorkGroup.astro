---
import type { WorkGroup, WorkTask } from '@/utils/work'

export interface Props {
  group: WorkGroup
  headingHref?: string // if set, the heading title links here
}

const { group, headingHref } = Astro.props as Props

function marker(status: WorkTask['status']): string {
  if (status === 'completed') return '✓'
  if (status === 'canceled') return '✕'
  return '○'
}

// e.g. "2026-05-26 11:57:09" -> "May 26, 2026"
function fmtDate(value: string | null): string | null {
  if (!value) return null
  const d = new Date(value.replace(' ', 'T'))
  if (Number.isNaN(d.getTime())) return null
  return d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })
}

const title = group.title ?? 'No project'
---

<section class='mb-10'>
  <div
    class='mb-4 flex items-baseline justify-between gap-3 border-b border-bd pb-2'
  >
    <h2 class='text-xl font-semibold text-fg1'>
      {headingHref ? (
        <a href={headingHref} class="hover:text-p1">
          {title}
        </a>
      ) : (
        title
      )}
    </h2>
  </div>

  <ul class='space-y-3'>
    {group.tasks.map((task) => {
      const done = task.status !== 'incomplete'
      // Backlog = the "Someday" bucket with no scheduled date. A Someday task
      // that DOES have a start_date is actually an Upcoming (future-scheduled)
      // task, not backlog. Muted, but not struck through like done ones.
      const backlog = !done && task.start === 'Someday' && !task.startDate
      const deadline = fmtDate(task.deadline)
      return (
        <li class="flex gap-3">
          <span
            class:list={[
              'select-none pt-0.5 text-sm',
              done || backlog ? 'text-fg2' : 'text-p1',
            ]}
          >
            {marker(task.status)}
          </span>
          <div class="min-w-0">
            <p
              class:list={[
                'leading-snug',
                done && 'text-fg2 line-through',
                backlog && 'text-fg2',
                !done && !backlog && 'text-fg1',
              ]}
            >
              {task.title || '(untitled)'}
              {backlog && (
                <span class="ml-2 whitespace-nowrap rounded bg-bg3 px-1.5 py-0.5 text-xs uppercase tracking-wide text-fg2">
                  backlog
                </span>
              )}
              {deadline && (
                <span class="ml-2 whitespace-nowrap rounded bg-bg3 px-1.5 py-0.5 text-xs text-fg2">
                  due {deadline}
                </span>
              )}
              {(task.tags || []).map((tag) => (
                <span class="ml-2 whitespace-nowrap rounded bg-bg3 px-1.5 py-0.5 text-xs text-fg2">
                  #{tag}
                </span>
              ))}
            </p>
          </div>
        </li>
      )
    })}
  </ul>
</section>
