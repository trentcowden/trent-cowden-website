---
export const prerender = false

import AssignButton from '@/partials/AssignButton.astro'
import WorkGroup from '@/partials/WorkGroup.astro'
import Base from '@/templates/Base.astro'
import { getWorkData } from '@/utils/work'

const { slug } = Astro.params

const data = await getWorkData()
const group = data?.groups.find((g) => g.slug === slug)

if (data && !group) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const groupTitle = group?.title ?? 'No heading'
const title = data ? `${groupTitle} — ${data.project.title}` : 'Work — Tasks'
const description = `A read-only view of my "${groupTitle}" work tasks.`
---

<Base head={{ title, description }}>
  <main class='mx-auto max-w-3xl px-4 py-12 flex gap-4 flex-col'>
    <div class='flex items-center justify-between gap-4'>
      <a href='/work' class='text-sm text-fg2 hover:text-p1'>← All projects</a>
      <AssignButton project={group?.title} />
    </div>
    {group ? <WorkGroup group={group} /> : null}
  </main>
</Base>
