---
export const prerender = false

import WorkGroup from '@/partials/WorkGroup.astro'
import Base from '@/templates/Base.astro'
import { getWorkData } from '@/utils/work'

const data = await getWorkData()

function updatedAgo(iso: string): string {
  const mins = Math.round((Date.now() - new Date(iso).getTime()) / 60000)
  if (mins < 1) return 'just now'
  if (mins < 60) return `${mins} min ago`
  const hrs = Math.round(mins / 60)
  if (hrs < 24) return `${hrs} hr${hrs === 1 ? '' : 's'} ago`
  const days = Math.round(hrs / 24)
  return `${days} day${days === 1 ? '' : 's'} ago`
}

const title = data ? `${data.project.title} — Tasks` : 'Work — Tasks'
const description = 'A read-only view of my current work tasks.'
---

<Base head={{ title, description }}>
  <main class='mx-auto max-w-3xl px-4 py-12'>
    <header class='mb-8'>
      <h1 class='text-3xl font-bold text-fg1'>
        {data?.project.title ?? 'Work'} tasks
      </h1>
      {
        data && (
          <p class='mt-1 text-sm text-fg2'>
            Updated {updatedAgo(data.generatedAt)} · {data.groups.length} heading
            {data.groups.length === 1 ? '' : 's'}
          </p>
        )
      }
    </header>

    {
      !data ? (
        <p class='text-fg2'>
          No data yet — the sync hasn’t run. Check back shortly.
        </p>
      ) : (
        data.groups.map((group) => (
          <WorkGroup group={group} headingHref={`/work/${group.slug}`} />
        ))
      )
    }
  </main>
</Base>
