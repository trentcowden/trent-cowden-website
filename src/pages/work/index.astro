---
export const prerender = false

import WorkGroup from '@/partials/WorkGroup.astro'
import Base from '@/templates/Base.astro'
import { getWorkData } from '@/utils/work'

const data = await getWorkData()

const title = data ? `${data.project.title} — Tasks` : 'Work — Tasks'
const description = 'A read-only view of my current work tasks.'
---

<Base head={{ title, description }}>
  <main class='mx-auto max-w-3xl px-4 py-12'>
    {data?.groups.map((group) => (
      <WorkGroup group={group} headingHref={`/work/${group.slug}`} />
    ))}
  </main>
</Base>
